	<parameter name="PERSON_ID" class="java.lang.Long"/>
	<parameter name="SUB_REPORT_DATA_SOURCE" class="java.lang.String"/>
	<query language="SQL"><![CDATA[SELECT
    id,
    author,
    launch_date AS launchDate,
    price,
    title
FROM books b
JOIN person_books pb ON pb.book_id = b.id
WHERE pb.person_id = $P{PERSON_ID}]]></query>
